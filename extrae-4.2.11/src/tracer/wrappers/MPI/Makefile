.SUFFIXES:
.SUFFIXES: .c .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am $(top_srcdir)/PATHS $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu --ignore-deps src/tracer/wrappers/MPI/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu --ignore-deps src/tracer/wrappers/MPI/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;
$(top_srcdir)/PATHS $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

clean-noinstLTLIBRARIES:
	-test -z "$(noinst_LTLIBRARIES)" || rm -f $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

libwrap_mpi_c.la: $(libwrap_mpi_c_la_OBJECTS) $(libwrap_mpi_c_la_DEPENDENCIES) $(EXTRA_libwrap_mpi_c_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libwrap_mpi_c_la_LINK)  $(libwrap_mpi_c_la_OBJECTS) $(libwrap_mpi_c_la_LIBADD) $(LIBS)

libwrap_mpi_cf.la: $(libwrap_mpi_cf_la_OBJECTS) $(libwrap_mpi_cf_la_DEPENDENCIES) $(EXTRA_libwrap_mpi_cf_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libwrap_mpi_cf_la_LINK) $(am_libwrap_mpi_cf_la_rpath) $(libwrap_mpi_cf_la_OBJECTS) $(libwrap_mpi_cf_la_LIBADD) $(LIBS)

libwrap_mpi_f.la: $(libwrap_mpi_f_la_OBJECTS) $(libwrap_mpi_f_la_DEPENDENCIES) $(EXTRA_libwrap_mpi_f_la_DEPENDENCIES) 
	$(AM_V_CCLD)$(libwrap_mpi_f_la_LINK)  $(libwrap_mpi_f_la_OBJECTS) $(libwrap_mpi_f_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

.c.o:
	$(AM_V_CC)$(COMPILE) -c -o $@ $<

.c.obj:
	$(AM_V_CC)$(COMPILE) -c -o $@ `$(CYGPATH_W) '$<'`

.c.lo:
	$(AM_V_CC)$(LTCOMPILE) -c -o $@ $<

libwrap_mpi_c_la-mpi_wrapper.lo: mpi_wrapper.c
	$(AM_V_CC)$(LIBTOOL) $(AM_V_lt) --tag=CC $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CC) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(AM_CPPFLAGS) $(CPPFLAGS) $(libwrap_mpi_c_la_CFLAGS) $(CFLAGS) -c -o libwrap_mpi_c_la-mpi_wrapper.lo `test -f 'mpi_wrapper.c' || echo '$(srcdir)/'`mpi_wrapper.c

